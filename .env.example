# ---------- Database (required) ----------
# MongoDB Atlas connection string. Include the database name before the "?".
MONGODB_URI=

# ---------- Authentication (required) ----------
# Long random string used to sign admin session tokens.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# ---------- Image & file storage (required for uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix inside your Cloudinary media library
CLOUDINARY_FOLDER=portfolio

# ---------- Site (optional) ----------
# Public base URL, used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- GitHub panel (optional) ----------
# Leave empty to show the placeholder state instead of live GitHub data.
GITHUB_USERNAME=
GITHUB_TOKEN=

# ---------- Contact email notifications (optional) ----------
# Messages are always stored in MongoDB. If these are set, a copy is emailed too.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=

# ---------- First admin user (used only by "npm run create-admin") ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
